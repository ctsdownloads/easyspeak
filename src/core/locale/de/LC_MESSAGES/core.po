msgid "I can't find a microphone, so I have to stop."
msgstr "Ich finde kein Mikrofon, deshalb muss ich mich beenden."

msgid "I couldn't turn voice control off, so I'll keep listening."
msgstr "Ich konnte die Sprachsteuerung nicht ausschalten, ich höre also weiter zu."

msgid "I didn't hear anything."
msgstr "Ich habe nichts gehört."

msgid "I didn't understand."
msgstr "Das habe ich nicht verstanden."

#, python-brace-format
msgid "Leaving {label}. Say {wake_word_spoken} to continue."
msgstr "Verlasse {label}. Sag {wake_word_spoken}, um weiterzumachen."

msgid "Sorry, I couldn't open the documentation page."
msgstr "Entschuldigung, ich konnte die Dokumentation nicht öffnen."

msgid "Sorry, I didn't understand."
msgstr "Entschuldigung, das habe ich nicht verstanden."

msgid "Sorry, something went wrong with that command."
msgstr "Entschuldigung, bei diesem Befehl ist etwas schiefgelaufen."

#, python-brace-format
msgid "This is {name}."
msgstr "Hier ist {name}."

#, python-brace-format
msgid "This is {name}. The details are in a notification."
msgstr "Hier ist {name}. Die Details stehen in einer Benachrichtigung."

msgid "Voice control turned off."
msgstr "Sprachsteuerung ausgeschaltet."

msgid "Welcome! I'm ready."
msgstr "Willkommen! Ich bin bereit."
