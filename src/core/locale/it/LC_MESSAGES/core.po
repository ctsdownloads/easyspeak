msgid "Dictation isn't available."
msgstr "La dettatura non è disponibile."

msgid "I can't find a microphone, so I have to stop."
msgstr "Non trovo nessun microfono, quindi devo fermarmi."

msgid "I couldn't turn voice control off, so I'll keep listening."
msgstr ""
"Non sono riuscito a disattivare il controllo vocale, quindi continuo ad "
"ascoltare."

msgid "I didn't hear anything."
msgstr "Non ho sentito nulla."

msgid "I didn't understand."
msgstr "Non ho capito."

#, python-brace-format
msgid "Leaving {label}. Say {wake_word_spoken} to continue."
msgstr "Esco da {label}. Di' {wake_word_spoken} per continuare."

msgid "Sorry, I couldn't open the documentation page."
msgstr "Mi dispiace, non sono riuscito ad aprire la documentazione."

msgid "Sorry, I didn't catch that."
msgstr "Mi dispiace, non ho capito bene."

msgid "Sorry, I didn't understand."
msgstr "Mi dispiace, non ho capito."

msgid "Sorry, something went wrong with that command."
msgstr "Mi dispiace, qualcosa è andato storto con questo comando."

#, python-brace-format
msgid "This is {name}."
msgstr "Sono {name}."

#, python-brace-format
msgid "This is {name}. The details are in a notification."
msgstr "Sono {name}. I dettagli sono in una notifica."

msgid "Voice control turned off."
msgstr "Controllo vocale disattivato."

msgid "Welcome! I'm ready."
msgstr "Benvenuto! Sono pronto."
