msgid "Dictation isn't available."
msgstr "La dictée n'est pas disponible."

msgid "I can't find a microphone, so I have to stop."
msgstr "Je ne trouve pas de microphone, je dois donc m'arrêter."

msgid "I couldn't turn voice control off, so I'll keep listening."
msgstr "Je n'ai pas pu désactiver la commande vocale, je continue donc d'écouter."

msgid "I didn't hear anything."
msgstr "Je n'ai rien entendu."

msgid "I didn't understand."
msgstr "Je n'ai pas compris."

#, python-brace-format
msgid "Leaving {label}. Say {wake_word_spoken} to continue."
msgstr "Je quitte {label}. Dites {wake_word_spoken} pour continuer."

msgid "Sorry, I couldn't open the documentation page."
msgstr "Désolé, je n'ai pas pu ouvrir la documentation."

msgid "Sorry, I didn't catch that."
msgstr "Désolé, ça m'a échappé."

msgid "Sorry, I didn't understand."
msgstr "Désolé, je n'ai pas compris."

msgid "Sorry, something went wrong with that command."
msgstr "Désolé, quelque chose s'est mal passé avec cette commande."

#, python-brace-format
msgid "This is {name}."
msgstr "Ici {name}."

#, python-brace-format
msgid "This is {name}. The details are in a notification."
msgstr "Ici {name}. Les détails sont dans une notification."

msgid "Voice control turned off."
msgstr "Commande vocale désactivée."

msgid "Welcome! I'm ready."
msgstr "Bienvenue ! Je suis prêt."
