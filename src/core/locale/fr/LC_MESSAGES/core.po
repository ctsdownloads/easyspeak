msgid "I couldn't turn voice control off, so I'll keep listening."
msgstr "Je n'ai pas pu désactiver la commande vocale, je continue donc d'écouter."

msgid "I didn't hear anything."
msgstr "Je n'ai rien entendu."

msgid "I didn't understand."
msgstr "Je n'ai pas compris."

#, python-brace-format
msgid "Leaving {label}. Say {wake_word_spoken} to continue."
msgstr "Je quitte {label}. Dites {wake_word_spoken} pour continuer."

#, python-brace-format
msgid "Sorry, I couldn't open the {what}."
msgstr "Désolé, je n'ai pas pu ouvrir {what}."

msgid "Sorry, I didn't understand."
msgstr "Désolé, je n'ai pas compris."

msgid "Voice control turned off."
msgstr "Commande vocale désactivée."

msgid "Welcome! I'm ready."
msgstr "Bienvenue ! Je suis prêt."
