msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 ou des suites comme '3 7 5' - zoomer sur la zone"

msgid "Clicked"
msgstr "Cliqué"

msgid "Double clicked"
msgstr "Double clic"

msgid "Dropped"
msgstr "Relâché"

msgid "Grid"
msgstr "Grille"

msgid "Grid closed"
msgstr "Grille fermée"

msgid "Holding"
msgstr "Je maintiens"

msgid "I couldn't click."
msgstr "Je n'ai pas pu cliquer."

msgid "I couldn't move the pointer."
msgstr "Je n'ai pas pu déplacer le pointeur."

msgid "I couldn't show the grid."
msgstr "Je n'ai pas pu afficher la grille."

msgid "I couldn't show the grid. Is the EasySpeak extension enabled?"
msgstr ""
"Je n'ai pas pu afficher la grille. L'extension EasySpeak est-elle activée"
" ?"

msgid "I tried, but I'm not sure it worked."
msgstr "J'ai essayé, mais je ne suis pas sûr que cela ait fonctionné."

msgid "Middle clicked"
msgstr "Clic du milieu"

msgid "Right clicked"
msgstr "Clic droit"

msgid "Scrolled"
msgstr "Défilé"

msgid "That needs the GNOME extension."
msgstr "Cela nécessite l'extension GNOME."

msgid "The mouse grid needs either the GNOME extension or ydotool."
msgstr "La grille de souris nécessite l'extension GNOME ou ydotool."

msgid "again - reopen grid at last position"
msgstr "again - rouvrir la grille à la dernière position"

msgid "click - left click"
msgstr "click - clic gauche"

msgid "close/cancel - hide grid"
msgstr "close/cancel - masquer la grille"

msgid "grid/mouse/pointer - show mouse grid"
msgstr "grid/mouse/pointer - afficher la grille de la souris"

msgid "mark - start drag, drag - end drag"
msgstr "mark - commencer le glisser, drag - le terminer"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - clic droit, double, du milieu"

msgid "scroll up/down/left/right [N]"
msgstr "scroll up/down/left/right [N] - faire défiler"

msgid "up/down/left/right [N] - nudge position"
msgstr "up/down/left/right [N] - déplacer la position"
