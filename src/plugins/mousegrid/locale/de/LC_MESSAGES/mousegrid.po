msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 oder Folgen wie '3 7 5' - in Zone(n) zoomen"

msgid "Clicked"
msgstr "Geklickt"

msgid "Double clicked"
msgstr "Doppelklick"

msgid "Dropped"
msgstr "Losgelassen"

msgid "Grid"
msgstr "Raster"

msgid "Grid closed"
msgstr "Raster geschlossen"

msgid "Holding"
msgstr "Halte"

msgid "I couldn't click."
msgstr "Ich konnte nicht klicken."

msgid "I couldn't move the pointer."
msgstr "Ich konnte den Zeiger nicht bewegen."

msgid "I couldn't show the grid."
msgstr "Ich konnte das Raster nicht anzeigen."

msgid "I couldn't show the grid. Is the EasySpeak extension enabled?"
msgstr ""
"Ich konnte das Raster nicht anzeigen. Ist die EasySpeak-Erweiterung "
"aktiviert?"

msgid "I tried, but I'm not sure it worked."
msgstr "Ich habe es versucht, aber ich bin nicht sicher, ob es geklappt hat."

msgid "Middle clicked"
msgstr "Mittelklick"

msgid "Right clicked"
msgstr "Rechtsklick"

msgid "Scrolled"
msgstr "Gescrollt"

msgid "That needs the GNOME extension."
msgstr "Das benötigt die GNOME-Erweiterung."

msgid "The mouse grid needs either the GNOME extension or ydotool."
msgstr "Das Mausraster benötigt entweder die GNOME-Erweiterung oder ydotool."

msgid "again - reopen grid at last position"
msgstr "again - Raster an letzter Position wieder öffnen"

msgid "click - left click"
msgstr "click - Linksklick"

msgid "close/cancel - hide grid"
msgstr "close/cancel - Raster ausblenden"

msgid "grid/mouse/pointer - show mouse grid"
msgstr "grid/mouse/pointer - Mausraster anzeigen"

msgid "mark - start drag, drag - end drag"
msgstr "mark - Ziehen beginnen, drag - Ziehen beenden"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - Rechts-, Doppel-, Mittelklick"

msgid "scroll up/down/left/right [N]"
msgstr "scroll up/down/left/right [N] - scrollen"

msgid "up/down/left/right [N] - nudge position"
msgstr "up/down/left/right [N] - Position verschieben"
