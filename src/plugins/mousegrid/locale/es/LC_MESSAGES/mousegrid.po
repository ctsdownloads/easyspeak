msgid "1-9 or chains like '3 7 5' - zoom to zone(s)"
msgstr "1-9 o cadenas como '3 7 5' - ampliar la zona"

msgid "Clicked"
msgstr "Clic"

msgid "Double clicked"
msgstr "Doble clic"

msgid "Dropped"
msgstr "Soltado"

msgid "Grid"
msgstr "Cuadrícula"

msgid "Grid closed"
msgstr "Cuadrícula cerrada"

msgid "Holding"
msgstr "Manteniendo"

msgid "Middle clicked"
msgstr "Clic central"

msgid "Right clicked"
msgstr "Clic derecho"

msgid "Scrolled"
msgstr "Desplazado"

msgid "again - reopen grid at last position"
msgstr "again - reabrir la cuadrícula en la última posición"

msgid "click - left click"
msgstr "click - clic izquierdo"

msgid "close/cancel - hide grid"
msgstr "close/cancel - ocultar la cuadrícula"

msgid "grid/mouse/pointer - show mouse grid"
msgstr "grid/mouse/pointer - mostrar la cuadrícula del ratón"

msgid "mark - start drag, drag - end drag"
msgstr "mark - empezar a arrastrar, drag - terminar"

msgid "right click / double click / middle click"
msgstr "right click / double click / middle click - clic derecho, doble, central"

msgid "scroll up/down/left/right [N]"
msgstr "scroll up/down/left/right [N] - desplazar"

msgid "up/down/left/right [N] - nudge position"
msgstr "up/down/left/right [N] - mover la posición"
