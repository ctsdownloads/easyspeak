msgid "Available Commands"
msgstr "Commandes disponibles"

msgid "Check the terminal for available commands."
msgstr "Les commandes disponibles sont dans le terminal."

msgid "Closing the About dialog."
msgstr "Je ferme la boîte de dialogue À propos."

msgid "Goodbye."
msgstr "Au revoir."

msgid "Modes now take commands on their own."
msgstr "Les modes acceptent maintenant les commandes directement."

msgid "Modes now wait for the wake word."
msgstr "Les modes attendent maintenant le mot d'activation."

msgid "Opening the About dialog."
msgstr "J'ouvre la boîte de dialogue À propos."

msgid "The About dialog isn't open."
msgstr "La boîte de dialogue À propos n'est pas ouverte."

msgid "exit EasySpeak"
msgstr "quitter EasySpeak"

msgid "list all commands"
msgstr "lister toutes les commandes"

msgid "modes accept bare commands again"
msgstr "les modes acceptent de nouveau les commandes directement"

msgid "modes wait for the wake word each command"
msgstr "les modes attendent le mot d'activation à chaque commande"

msgid "show the About dialog"
msgstr "afficher la boîte de dialogue À propos"
