msgid "Available Commands"
msgstr "Comandos disponibles"

msgid "Check the terminal for available commands."
msgstr "Los comandos disponibles están en el terminal."

msgid "Goodbye."
msgstr "Adiós."

msgid "Modes now take commands on their own."
msgstr "Los modos ahora aceptan comandos directamente."

msgid "Modes now wait for the wake word."
msgstr "Los modos ahora esperan la palabra de activación."

msgid "exit EasySpeak"
msgstr "salir de EasySpeak"

msgid "list all commands"
msgstr "listar todos los comandos"

msgid "modes accept bare commands again"
msgstr "los modos vuelven a aceptar comandos directamente"

msgid "modes wait for the wake word each command"
msgstr "los modos esperan la palabra de activación en cada comando"
