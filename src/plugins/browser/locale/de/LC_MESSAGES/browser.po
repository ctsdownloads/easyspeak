msgid "Ad blocking off"
msgstr "Werbeblocker aus"

msgid "Ad blocking on"
msgstr "Werbeblocker an"

msgid "Browser"
msgstr "Browser"

msgid "Closing browser."
msgstr "Browser wird geschlossen."

msgid "Could not write the browser config."
msgstr "Die Browser-Konfiguration konnte nicht geschrieben werden."

msgid "Hardware rendering on"
msgstr "Hardware-Rendering an"

msgid "Hints closed"
msgstr "Hinweise geschlossen"

msgid "Keystrokes need GNOME."
msgstr "Tastendrücke brauchen GNOME."

msgid "Left the browser"
msgstr "Browser verlassen"

msgid "No hints on this page"
msgstr "Keine Hinweise auf dieser Seite"

#, python-brace-format
msgid "Opening {site}."
msgstr "{site} wird geöffnet."

#, python-brace-format
msgid "Opening {url}."
msgstr "{url} wird geöffnet."

msgid "Ready"
msgstr "Bereit"

msgid "Reloading"
msgstr "Wird neu geladen"

#, python-brace-format
msgid "Saved as {name}."
msgstr "Gespeichert als {name}."

#, python-brace-format
msgid "Searching for {query}."
msgstr "Suche nach {query}."

msgid "Software rendering on"
msgstr "Software-Rendering an"

msgid "The browser isn't running."
msgstr "Der Browser läuft nicht."

msgid "[number] - click hint (e.g. 'one' = 1, 'zero two' = 02)"
msgstr "[number] - Hinweis anklicken (z. B. 'one' = 1, 'zero two' = 02)"

msgid "back - go back"
msgstr "back - zurück"

msgid "close tab - close current tab"
msgstr "close tab - aktuellen Tab schließen"

msgid "close tab [number] - close a tab (or 'close tab' for this one)"
msgstr "close tab [number] - einen Tab schließen (oder 'close tab' für diesen)"

msgid "find [text] - search on page"
msgstr "find [text] - auf der Seite suchen"

msgid "forward - go forward"
msgstr "forward - vorwärts"

msgid "go to [site] - open bookmarked site"
msgstr "go to [site] - gespeicherte Seite öffnen"

msgid "last tab - go to the previous tab"
msgstr "last tab - zum vorherigen Tab"

msgid "new tab - open new tab"
msgstr "new tab - neuen Tab öffnen"

msgid "next tab / switch tab - go to the next tab"
msgstr "next tab / switch tab - zum nächsten Tab"

msgid "numbers - show click hints"
msgstr "numbers - Klick-Hinweise anzeigen"

msgid "reload - refresh page"
msgstr "reload - Seite neu laden"

msgid "scroll up/down - scroll page"
msgstr "scroll up/down - Seite scrollen"

msgid "search [query] - search the web"
msgstr "search [query] - im Web suchen"

msgid "tab [number] - switch to a tab by number"
msgstr "tab [number] - zu Tab Nummer wechseln"

msgid "top / bottom - jump to top/bottom"
msgstr "top / bottom - zum Anfang/Ende springen"

#, python-brace-format
msgid "{spoken}. Restarting the browser."
msgstr "{spoken}. Browser wird neu gestartet."
