msgid "Ad blocking off"
msgstr "Bloqueo de anuncios desactivado"

msgid "Ad blocking on"
msgstr "Bloqueo de anuncios activado"

msgid "Browser"
msgstr "Navegador"

msgid "Closing browser."
msgstr "Cierro el navegador."

msgid "Could not write the browser config."
msgstr "No se ha podido escribir la configuración del navegador."

msgid "Hardware rendering on"
msgstr "Renderizado por hardware activado"

msgid "Hints closed"
msgstr "Pistas cerradas"

msgid "Keystrokes need GNOME."
msgstr "Las pulsaciones de teclas necesitan GNOME."

msgid "Left the browser"
msgstr "Navegador abandonado"

msgid "No hints on this page"
msgstr "No hay pistas en esta página"

#, python-brace-format
msgid "Opening {site}."
msgstr "Abro {site}."

#, python-brace-format
msgid "Opening {url}."
msgstr "Abro {url}."

msgid "Ready"
msgstr "Listo"

msgid "Reloading"
msgstr "Recargando"

#, python-brace-format
msgid "Saved as {name}."
msgstr "Guardado como {name}."

#, python-brace-format
msgid "Searching for {query}."
msgstr "Busco {query}."

msgid "Software rendering on"
msgstr "Renderizado por software activado"

msgid "The browser isn't running."
msgstr "El navegador no está en ejecución."

msgid "[number] - click hint (e.g. 'one' = 1, 'zero two' = 02)"
msgstr "[number] - pulsar la pista (p. ej. 'one' = 1, 'zero two' = 02)"

msgid "back - go back"
msgstr "back - atrás"

msgid "close tab - close current tab"
msgstr "close tab - cerrar la pestaña actual"

msgid "close tab [number] - close a tab (or 'close tab' for this one)"
msgstr "close tab [number] - cerrar una pestaña (o 'close tab' para esta)"

msgid "find [text] - search on page"
msgstr "find [text] - buscar en la página"

msgid "forward - go forward"
msgstr "forward - adelante"

msgid "go to [site] - open bookmarked site"
msgstr "go to [site] - abrir un sitio guardado"

msgid "last tab - go to the previous tab"
msgstr "last tab - ir a la pestaña anterior"

msgid "new tab - open new tab"
msgstr "new tab - abrir una pestaña nueva"

msgid "next tab / switch tab - go to the next tab"
msgstr "next tab / switch tab - ir a la pestaña siguiente"

msgid "numbers - show click hints"
msgstr "numbers - mostrar pistas de clic"

msgid "reload - refresh page"
msgstr "reload - recargar la página"

msgid "scroll up/down - scroll page"
msgstr "scroll up/down - desplazar la página"

msgid "search [query] - search the web"
msgstr "search [query] - buscar en la web"

msgid "tab [number] - switch to a tab by number"
msgstr "tab [number] - ir a la pestaña con ese número"

msgid "top / bottom - jump to top/bottom"
msgstr "top / bottom - ir al principio/al final"

#, python-brace-format
msgid "{spoken}. Restarting the browser."
msgstr "{spoken}. Reinicio el navegador."
