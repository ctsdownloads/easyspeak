msgid "Already tracking"
msgstr "Tracciamento già attivo"

msgid "Following"
msgstr "Seguo"

msgid "Frozen"
msgstr "Bloccato"

msgid "Not tracking"
msgstr "Tracciamento non attivo"

msgid "Recalibrating"
msgstr "Ricalibro"

msgid "Stopped"
msgstr "Fermato"

msgid "Tracking"
msgstr "Tracciamento attivo"

msgid "click - left click at cursor"
msgstr "click - clic sinistro sul cursore"

msgid "double click - double click"
msgstr "double click - doppio clic"

msgid "freeze - lock cursor position"
msgstr "freeze - blocca il cursore"

msgid "go - resume tracking"
msgstr "go - riprende il tracciamento"

msgid "nudge up/down/left/right - fine tune position"
msgstr "nudge up/down/left/right - regola la posizione"

msgid "recalibrate - reset center position"
msgstr "recalibrate - ricalibra il centro"

msgid "right click - right click"
msgstr "right click - clic destro"

msgid "start tracking - begin head tracking"
msgstr "start tracking - avvia il tracciamento della testa"

msgid "stop tracking - end tracking"
msgstr "stop tracking - termina il tracciamento"
